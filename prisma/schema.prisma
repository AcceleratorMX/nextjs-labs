generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Article {
  id        String   @id @default(uuid())
  title     String
  body      String
  userId    Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Comment {
  id        String   @id @default(uuid())
  articleId String
  name      String
  email     String
  body      String
  createdAt DateTime @default(now())
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  password  String?  // Optional: OAuth users (Google, GitHub) don't have a password
  image     String?
  age       Int?
  provider  String   @default("credentials") // "credentials" | "google" | "github"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
